GEMINI_API_KEY=
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Generate a random secret with at least 32 bytes for production and set it
# in your hosting provider's environment variables (including Vercel).
SESSION_SECRET=
# Paystack test or live secret key; never expose it in frontend code.
PAYSTACK_SECRET_KEY=
# Public app URL used as the hosted-checkout return URL. Vercel's deployment
# URL is used automatically if this is unset, but set your production domain.
APP_BASE_URL=http://localhost:3000
ALLOW_GUEST_ACCESS=false
SHOW_OTP_DEV_CODES=true
PORT=3000
NODE_ENV=development

# Production requirements:
# - Set APP_BASE_URL to your public HTTPS URL.
# - Set SESSION_SECRET to a unique random value of at least 32 bytes.
# - Configure Google OAuth with the production domain.
# - Register MICROSOFT_CLIENT_ID as a confidential web app and add
#   https://your-domain/auth/microsoft/callback as its redirect URI.
# - Store MICROSOFT_CLIENT_SECRET only in the server environment.
# - Use a persistent shared session store; the built-in store is development-only.
# - Keep API and payment secrets only in the server environment.
