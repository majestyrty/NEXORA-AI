GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional OpenAI model ID override for NEX N1; defaults to gpt-6-luna.
NEX_N1_MODEL=
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# PostgreSQL connection string for persistent accounts, OTPs, cooldowns and sessions.
DATABASE_URL=
# Resend email API key and a sender address on a domain verified with Resend.
RESEND_API_KEY=
# Resend's onboarding sender is for limited testing; use a sender on your verified domain for general recipients.
EMAIL_FROM="Nexora AI <onboarding@resend.dev>"
# Optional dedicated HMAC secret; SESSION_SECRET is used when this is unset.
OTP_HASH_SECRET=
# Generate a random secret with at least 32 bytes for production and set it
# in your hosting provider's environment variables (including Vercel).
# Public pages load without it, but authentication is disabled until configured.
SESSION_SECRET=
# Paystack test or live secret key; never expose it in frontend code.
PAYSTACK_SECRET_KEY=
# Public app URL used as the hosted-checkout return URL. Vercel's deployment
# URL is used automatically if this is unset, but set your production domain.
APP_BASE_URL=http://localhost:3000
ALLOW_GUEST_ACCESS=false
PORT=3000
NODE_ENV=development

# Production requirements:
# - Set APP_BASE_URL to your public HTTPS URL.
# - Set SESSION_SECRET to a unique random value of at least 32 bytes.
# - Configure Google OAuth with the production domain.
# - Register MICROSOFT_CLIENT_ID as a confidential web app and add
#   https://your-domain/auth/microsoft/callback as its redirect URI.
# - Store MICROSOFT_CLIENT_SECRET only in the server environment.
# - Verify your sending domain with Resend and set RESEND_API_KEY and EMAIL_FROM.
# - Set DATABASE_URL to a managed PostgreSQL connection string for persistent email auth and shared sessions.
# - Keep API and payment secrets only in the server environment.
